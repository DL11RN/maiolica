{
  "name": "@maiolica/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/* --external:socket.io --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@maiolica/shared": "*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
